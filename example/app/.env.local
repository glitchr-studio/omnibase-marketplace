APP_ENV=dev
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
MAILER_DSN=null://null

# --- Shopify -----------------------------------------------------------------
# Leave SHOPIFY_ENABLED unset and the demo is the plain shop it always was.
# Set it, with a development store's credentials, and the entrypoint flips
# marketplace.shopify.enabled to true before the container is compiled.
#
#   Shopify admin -> Settings -> Apps and sales channels -> Develop apps
#   Scopes: read_products, read_inventory, write_draft_orders, read_orders
#   (add write_orders only if you turn the export role on)
#
# SHOPIFY_ENABLED=1
# SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHOPIFY_WEBHOOK_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-07
