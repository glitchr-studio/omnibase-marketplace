# syntax=docker/dockerfile:1
#
# The demo shop, with the optional Shopify integration wired in.
#
# It is the same image as the root Dockerfile plus symfony/http-client,
# symfony/messenger, the Shopify fixtures and an entrypoint that switches the
# integration on when credentials are present. With no credentials it boots as
# the plain demo - which is itself the point being demonstrated: the
# integration costs nothing when it is off.
#
#   docker build -f Dockerfile.shopify -t base-bundle-marketplace-shopify .
#   docker run --rm -p 8000:8000 \
#     -e SHOPIFY_ENABLED=1 \
#     -e SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com \
#     -e SHOPIFY_ADMIN_TOKEN=shpat_xxx \
#     -e SHOPIFY_WEBHOOK_SECRET=shpss_xxx \
#     base-bundle-marketplace-shopify
#
#   -> http://localhost:8000/                   the tour
#   -> http://localhost:8000/boutique/boutique  the shop
#
# Or, with the same variables in a .env file, `docker compose -f
# docker-compose.shopify.yml up --build`.
#
# The credentials come from a Shopify DEVELOPMENT STORE's custom app:
#   Settings -> Apps and sales channels -> Develop apps -> Create an app
#   API scopes: read_products, read_inventory, write_draft_orders, read_orders
#   (write_orders as well, only if you turn marketplace.shopify.export on)
# The Admin API access token is shpat_...; the webhook secret is the app's
# API secret key.

FROM php:8.4-cli

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git unzip libicu-dev libzip-dev libpng-dev libjpeg-dev libwebp-dev libfreetype-dev libxslt1-dev libmagickwand-dev \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd --with-jpeg --with-webp --with-freetype \
    && docker-php-ext-install -j"$(nproc)" intl zip gd bcmath ftp xsl exif \
    && pecl install imagick igbinary \
    && docker-php-ext-enable imagick igbinary

COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
ENV COMPOSER_ALLOW_SUPERUSER=1

# --- bare Symfony skeleton ---------------------------------------------------
WORKDIR /srv/demo
RUN composer create-project symfony/skeleton . --no-interaction --no-progress

RUN composer config minimum-stability dev \
    && composer config prefer-stable true \
    && composer config extra.symfony.allow-contrib true \
    && composer config allow-plugins.glitchr/base-plugin true \
    && composer config allow-plugins.glitchr/doctrine-dc2type true \
    && composer config allow-plugins.endroid/installer true \
    && composer config allow-plugins.php-http/discovery true \
    && composer config repositories.backup-manager vcs https://gitlab.glitchr.dev/public-repository/agnostic/backup-manager \
    && composer config repositories.base-bundle vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/component \
    && composer config repositories.base-bundle-admin vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/extension/admin \
    && composer config repositories.base-plugin vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/plugin \
    && composer config repositories.doctrine-dc2type vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/doctrine-dc2type \
    && composer config repositories.well-known vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/well-known \
    && composer config repositories.ux-google vcs https://gitlab.glitchr.dev/public-repository/symfony/bundle/ux/google-api

COPY . /srv/base-bundle-marketplace

# symfony/http-client is what the Shopify subtree talks over, and
# symfony/messenger is what carries the order push out of the request. Both
# are the APPLICATION's dependencies, not the bundle's - that asymmetry is
# exactly what config/shopify.php's class_exists guard is checking.
RUN composer config repositories.base-bundle-marketplace '{"type": "path", "url": "/srv/base-bundle-marketplace", "options": {"symlink": false}}' \
    && composer require "glitchr/omnibase:3.x-dev as 3.0.x-dev" "omnibase/marketplace:*@dev" \
        symfony/translation symfony/http-client symfony/messenger \
        --no-interaction --no-progress --no-scripts \
    && rm -f config/packages/google_recaptcha.yaml config/packages/webauthn.yaml config/routes/webauthn_routes.yaml config/routes/api_platform.yaml

RUN cd vendor/glitchr/omnibase \
    && git apply -p1 /srv/base-bundle-marketplace/example/patches/glitchr-base-bundle-doctrine-collections-3.patch

# --- demo app overlay --------------------------------------------------------
COPY example/app/ ./

RUN rm -rf var/cache \
    && echo "memory_limit = 512M" > /usr/local/etc/php/conf.d/zz-demo.ini

# The integration's on/off switch is read while the container COMPILES, where
# an env placeholder is still an unresolved string - so it cannot be one. The
# entrypoint rewrites the literal in marketplace.yaml from the environment before
# anything is warmed, which is the honest way to drive a compile-time flag
# from a runtime variable.
COPY <<'ENTRYPOINT' /usr/local/bin/demo-entrypoint
#!/bin/sh
set -e
CONFIG=/srv/demo/config/packages/marketplace.yaml

if [ -n "$SHOPIFY_ENABLED" ] && [ -n "$SHOPIFY_SHOP_DOMAIN" ] && [ -n "$SHOPIFY_ADMIN_TOKEN" ]; then
    # Only the line inside the shopify: block, which is the indented one.
    sed -i 's/^        enabled: false$/        enabled: true/' "$CONFIG"
    echo "Shopify: ON  ($SHOPIFY_SHOP_DOMAIN)"
    SHOPIFY_ON=1
else
    echo "Shopify: off (set SHOPIFY_ENABLED, SHOPIFY_SHOP_DOMAIN and SHOPIFY_ADMIN_TOKEN to turn it on)"
    SHOPIFY_ON=
fi

rm -rf var/cache
php bin/console doctrine:schema:create --no-interaction || true
php bin/console assets:install public --no-interaction
php bin/console cache:warmup

if [ -n "$SHOPIFY_ON" ]; then
    php bin/console demo:shopify:seed || true
    echo "--- marketplace:shopify:ping ---"
    php bin/console marketplace:shopify:ping || echo "ping failed: check the domain, the token and the API version"
    echo "--- marketplace:shopify:catalogue:sync --dry-run --limit=5 ---"
    php bin/console marketplace:shopify:catalogue:sync --dry-run --limit=5 || true
    echo
    echo "To write the catalogue for real:   docker exec -it <container> php bin/console marketplace:shopify:catalogue:sync"
    echo "To install the webhooks:           docker exec -it <container> php bin/console marketplace:shopify:webhooks --install --callback=https://<your-tunnel>/marketplace/shopify/webhook"
fi

exec php -S 0.0.0.0:8000 -t public
ENTRYPOINT
RUN chmod +x /usr/local/bin/demo-entrypoint

EXPOSE 8000
CMD ["demo-entrypoint"]
