{#
 # An order's (or a cart's) VAT under its lines: "Total HT", "TVA (20 %)",
 # "Total TTC" - or, for an order sold without VAT, its total and the
 # mention an invoice must carry (a reverse charge, art. 293 B du CGI).
 # Without VAT at all, just the total.
 #
 #   order    the order or cart
 #   layout   'list' (the summary's <li>) or 'table' (the cart's <tfoot> rows)
 #}
{% macro row(layout, label, amount, currency, class) %}
    {% if layout == 'table' %}
        <tr class="{{ class }}">{% if amount is null %}<td colspan="5" class="num"><small>{{ label }}</small></td>{% else %}<th colspan="3" class="num">{{ label }}</th><th class="num">{% include '@Market/client/_price.html.twig' with {amount: amount, currency: currency} %}</th><th></th>{% endif %}</tr>
    {% else %}
        <li class="{{ class }}">{% if amount is null %}<small>{{ label }}</small>{% else %}<span>{{ label }}</span>{% include '@Market/client/_price.html.twig' with {amount: amount, currency: currency} %}{% endif %}</li>
    {% endif %}
{% endmacro %}
{% import _self as vat %}
{% set _layout = layout|default('list') %}
{% set _vat = order.vatCharge %}
{% if order.vatExemption %}
    {{ vat.row(_layout, '@market.cart.grand_total'|trans, order.netPrice, order.currency, 'market-summary-total') }}
    {{ vat.row(_layout, order.vatExemption, null, order.currency, 'market-summary-mention') }}
{% elseif _vat > 0 %}
    {% set _rates = market_vat_rates(order) %}
    {{ vat.row(_layout, '@market.cart.total_ht'|trans, order.netPrice - _vat, order.currency, 'market-summary-subtotal') }}
    {{ vat.row(_layout, _rates|length == 1 ? '@market.cart.vat_rate'|trans({rate: _rates[0] * 100}) : '@market.cart.vat'|trans, _vat, order.currency, 'market-summary-vat') }}
    {{ vat.row(_layout, '@market.cart.total_ttc'|trans, order.netPrice, order.currency, 'market-summary-total') }}
{% else %}
    {{ vat.row(_layout, '@market.cart.grand_total'|trans, order.netPrice, order.currency, 'market-summary-total') }}
{% endif %}
