{% extends '@Marketplace/client/layout.html.twig' %}

{% block marketplace_body %}
{% if stores|length == 0 %}
    <p class="marketplace-empty">{{ '@marketplace.stores.empty'|trans }}</p>
{% else %}
<div class="marketplace-stores">
    {% for store in stores %}
        <a class="marketplace-store-card" href="{{ path('marketplace_store', {slug: store.slug}) }}">
            <span class="marketplace-store-name">{{ store.title }}</span>
            {% if store.excerpt %}<span class="marketplace-store-excerpt">{{ store.excerpt|striptags }}</span>{% endif %}
            <span class="marketplace-store-go">{{ '@marketplace.stores.enter'|trans }} →</span>
        </a>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
