{% extends '@Marketplace/client/layout.html.twig' %}

{% block marketplace_title %}{{ store.title }}{% endblock %}
{% block marketplace_crumbs %}<span>›</span> <span>{{ store.title }}</span>{% endblock %}

{% block marketplace_body %}
    {% if store.excerpt or store.content %}<div class="marketplace-intro">{{ (store.excerpt ?: store.content)|striptags }}</div>{% endif %}
    {% if not store.open %}<p class="marketplace-closed"><i class="fa-solid fa-door-closed"></i> {{ '@marketplace.store.closed'|trans }}</p>{% endif %}

    {% if products|length == 0 %}
        <p class="marketplace-empty">{{ '@marketplace.store.empty'|trans }}</p>
    {% else %}
        <div class="marketplace-grid">
            {% for product in products %}{% include '@Marketplace/client/_product_card.html.twig' with {product: product, store: store} %}{% endfor %}
        </div>
        {{ paginator(products, 'marketplace_store', {slug: store.slug}) }}
    {% endif %}
{% endblock %}

{% block marketplace_aside %}
    {% if cart %}
    <div class="marketplace-box">
        <div class="marketplace-box-title"><i class="fa-solid fa-basket-shopping"></i> {{ '@marketplace.cart.title'|trans }}</div>
        <div class="marketplace-box-body">
            <p>{{ '@marketplace.cart.lines'|trans({count: cart.items|length}) }} · {% include '@Marketplace/client/_price.html.twig' with {amount: cart.netPrice, currency: cart.currency} %}</p>
            <a class="marketplace-btn marketplace-btn-primary" href="{{ path('marketplace_checkout', {order: cart.id}) }}">{{ '@marketplace.cart.checkout'|trans }}</a>
        </div>
    </div>
    {% endif %}
{% endblock %}
