{#
 # A price in a currency. Variables: amount (smallest unit: cents, or one of
 # an in-game currency), currency (ISO code or a made-up one).
 # Override to spell a currency of your own - Chapaland does for its pepettes.
 #}
{% set amount = amount|default(0) %}
{% set currency = currency|default('EUR') %}
<span class="market-price">{{ (amount / 100)|format_currency(currency) }}</span>
