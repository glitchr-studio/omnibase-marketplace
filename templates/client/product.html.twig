{% extends '@Marketplace/client/layout.html.twig' %}

{% block marketplace_title %}{{ product.title }}{% endblock %}
{% block marketplace_crumbs %}<span>›</span> <a href="{{ path('marketplace_store', {slug: store.slug}) }}">{{ store.title }}</a> <span>›</span> <span>{{ product.title }}</span>{% endblock %}

{% block marketplace_body %}
{% if marketplace_age_gate(product) %}{% include '@Marketplace/client/_age_gate.html.twig' %}{% endif %}
<article class="marketplace-product">
    <div class="marketplace-product-media">{% include '@Marketplace/client/_product_media.html.twig' with {product: product, size: 'large'} %}</div>
    <div class="marketplace-product-text">
        <h2>{{ product.title }}</h2>
        {% if product.headline and product.headline != product.title %}<p class="marketplace-product-headline">{{ product.headline }}</p>{% endif %}
        <p class="marketplace-product-price">{% include '@Marketplace/client/_price.html.twig' with {amount: product.unitPrice, currency: product.currency} %}</p>
        {% if product.stock is not null %}<p class="marketplace-product-stock">{{ '@marketplace.product.stock'|trans({count: product.stock}) }}</p>{% endif %}

        {% if product.forSell %}
            {% if is_granted('ROLE_USER') %}
            <form method="post" action="{{ path('marketplace_cart_add', {id: product.id}) }}" class="marketplace-add">
                <input type="hidden" name="_token" value="{{ csrf_token('marketplace_cart') }}">
                {% if product.packSize > 1 or product.minimumQuantity > 1 %}<input type="hidden" name="quantity" value="{{ product.minimumQuantity }}">{% endif %}
                <button class="marketplace-btn marketplace-btn-primary" type="submit"><i class="fa-solid fa-basket-shopping"></i> {{ '@marketplace.product.add'|trans }}</button>
            </form>
            {% else %}
                <p>{{ '@marketplace.product.login'|trans({login: path('security_login')})|raw }}</p>
            {% endif %}
        {% else %}
            <p class="marketplace-soldout">{{ '@marketplace.product.unavailable'|trans }}</p>
        {% endif %}

        {% include '@Marketplace/client/_product_trade.html.twig' %}

        {% if product.content %}<div class="marketplace-product-content">{{ product.content|striptags('<p><b><i><em><strong><ul><li><br>')|raw }}</div>{% endif %}
    </div>
</article>
{% endblock %}
