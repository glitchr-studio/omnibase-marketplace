{# A product on a shelf. Variables: product, store. #}
<article class="marketplace-card{{ not product.forSell ? ' is-unavailable' }}">
    <a class="marketplace-card-media" href="{{ path('marketplace_product', {store: store.slug, slug: product.slug}) }}">
        {% include '@Marketplace/client/_product_media.html.twig' with {product: product, size: 'card'} %}
    </a>
    <div class="marketplace-card-body">
        <a class="marketplace-card-title" href="{{ path('marketplace_product', {store: store.slug, slug: product.slug}) }}">{{ product.title }}</a>
        {% set excerpt = product.excerpt|default('')|striptags|trim %}
        {% if excerpt %}<p class="marketplace-card-excerpt">{{ excerpt|length > 90 ? excerpt|slice(0, 89) ~ '…' : excerpt }}</p>{% endif %}
        <div class="marketplace-card-foot">
            {% include '@Marketplace/client/_price.html.twig' with {amount: product.startingPrice, currency: product.currency, price_from: product.pricedFrom} %}
            {% if product.forSell and is_granted('ROLE_USER') %}
                <form method="post" action="{{ path('marketplace_cart_add', {id: product.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace_cart') }}">
                    <button class="marketplace-btn marketplace-btn-primary marketplace-btn-sm" type="submit"><i class="fa-solid fa-basket-shopping"></i> {{ '@marketplace.product.add'|trans }}</button>
                </form>
            {% elseif not product.forSell %}
                <span class="marketplace-soldout">{{ '@marketplace.product.unavailable'|trans }}</span>
            {% endif %}
        </div>
    </div>
</article>
