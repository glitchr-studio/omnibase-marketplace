{% extends '@Marketplace/client/layout.html.twig' %}

{% set store = order.store %}
{% block marketplace_title %}{{ '@marketplace.checkout.title'|trans }}{% endblock %}
{% block marketplace_crumbs %}<span>›</span> <a href="{{ path('marketplace_cart') }}">{{ '@marketplace.cart.title'|trans }}</a> <span>›</span> <span>{{ '@marketplace.checkout.title'|trans }}</span>{% endblock %}

{% block marketplace_body %}
<section class="marketplace-checkout">
    <h2>{{ '@marketplace.checkout.review'|trans }}</h2>
    {% include '@Marketplace/client/_totals.html.twig' with {order: order} %}
    {% if needs_shipping and not order.shippingMethod %}<p class="marketplace-note">{{ '@marketplace.shipping.plus'|trans }}</p>{% endif %}

    {% if methods|length == 0 %}
        <p class="marketplace-empty">{{ '@marketplace.checkout.no_method'|trans }}</p>
    {% else %}
    {# "reload": a real submission, which a page-swapping script (Transparent) leaves alone - the answer can be a redirect to the payment provider's own site, which a script cannot follow. #}
    <form method="post" class="marketplace-methods reload">
        <input type="hidden" name="_token" value="{{ csrf_token('marketplace_checkout_' ~ order.id) }}">

        {% if needs_shipping %}
        <h2>{{ '@marketplace.shipping.address'|trans }}</h2>
        <div class="marketplace-address">
            <label class="wide">{{ '@marketplace.shipping.field.name'|trans }}<input type="text" name="address[name]" value="{{ address.name }}" required maxlength="128" autocomplete="name"></label>
            <label class="wide">{{ '@marketplace.shipping.field.street'|trans }}<input type="text" name="address[street]" value="{{ address.street }}" required maxlength="255" autocomplete="address-line1"></label>
            <label class="wide">{{ '@marketplace.shipping.field.additional'|trans }}<input type="text" name="address[additional]" value="{{ address.additional }}" maxlength="255" autocomplete="address-line2"></label>
            <label>{{ '@marketplace.shipping.field.zip'|trans }}<input type="text" name="address[zip]" value="{{ address.zip }}" required maxlength="16" autocomplete="postal-code"></label>
            <label>{{ '@marketplace.shipping.field.city'|trans }}<input type="text" name="address[city]" value="{{ address.city }}" required maxlength="128" autocomplete="address-level2"></label>
            <label>{{ '@marketplace.shipping.field.country'|trans }}<input type="text" name="address[country]" value="{{ address.country }}" required maxlength="2" autocomplete="country"></label>
            <label>{{ '@marketplace.shipping.field.phone'|trans }}<input type="tel" name="address[phone]" value="{{ address.phone }}" maxlength="32" autocomplete="tel"></label>
        </div>

        <h2>{{ '@marketplace.shipping.title'|trans }}</h2>
        {% if shipping_options|length == 0 %}
            <p class="marketplace-empty">{{ '@marketplace.shipping.none'|trans }}</p>
        {% endif %}
        {% for option in shipping_options %}
            <label class="marketplace-method">
                <input type="radio" name="shipping" value="{{ option.method.id }}" {{ (order.shippingMethod and order.shippingMethod.id == option.method.id) or (not order.shippingMethod and loop.first) ? 'checked' }} required>
                <span class="marketplace-method-label">{{ option.method.label }}</span>
                <span class="marketplace-method-extra">{% include '@Marketplace/client/_price.html.twig' with {amount: option.charge, currency: order.currency} %}{% if option.method.deliveryTime %} · {{ '@marketplace.shipping.days'|trans({count: option.method.deliveryTime}) }}{% endif %}</span>
            </label>
        {% endfor %}
        {% endif %}

        <h2>{{ '@marketplace.checkout.pay_with'|trans }}</h2>
        {% for method in methods %}
            <label class="marketplace-method">
                <input type="radio" name="method" value="{{ method.id }}" {{ loop.first ? 'checked' }}>
                <span class="marketplace-method-label">{{ method.label ?? method.slug }}</span>
            </label>
        {% endfor %}
        <button class="marketplace-btn marketplace-btn-primary" type="submit"><i class="fa-solid fa-lock"></i> {{ '@marketplace.checkout.confirm'|trans }}</button>
    </form>
    {% endif %}
</section>
{% endblock %}
