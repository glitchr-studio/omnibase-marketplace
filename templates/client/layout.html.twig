{#
 # The shop's chrome inside the host's layout: a banner (overridable per
 # store), the cart link, the flashes, then the page. Every shop page
 # extends this and fills `marketplace_body`.
 #}
{% extends 'layout1.html.twig' %}

{% block title %}{{ block('marketplace_title') is defined ? block('marketplace_title') : '@marketplace.stores.title'|trans }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/marketplace/css/marketplace.css') }}">
{% endblock %}

{% block content %}
<div class="marketplace{{ store is defined and store ? ' marketplace-store-' ~ store.slug }}">
    {% include '@Marketplace/client/_banner.html.twig' with {store: store ?? null} %}

    <div class="marketplace-bar" role="navigation">
        <a href="{{ path('marketplace_stores') }}"><i class="fa-solid fa-store"></i> {{ '@marketplace.stores.title'|trans }}</a>
        {% block marketplace_crumbs %}{% endblock %}
        <span class="marketplace-bar-end">
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('marketplace_orders') }}"><i class="fa-solid fa-receipt"></i> {{ '@marketplace.orders.title'|trans }}</a>
                <a class="marketplace-cart-link" href="{{ path('marketplace_cart') }}"><i class="fa-solid fa-basket-shopping"></i> {{ '@marketplace.cart.title'|trans }}{% set n = marketplace_cart_count() %}{% if n %} <span class="marketplace-badge">{{ n }}</span>{% endif %}</a>
            {% endif %}
        </span>
    </div>

    {% include 'flashbag.html.twig' ignore missing %}

    {% block marketplace_body %}{% endblock %}
</div>
{% endblock %}

{% block aside %}{% block marketplace_aside %}{% endblock %}{% endblock %}
