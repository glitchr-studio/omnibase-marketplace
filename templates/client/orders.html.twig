{% extends '@Marketplace/client/layout.html.twig' %}

{% block marketplace_title %}{{ '@marketplace.orders.title'|trans }}{% endblock %}
{% block marketplace_crumbs %}<span>›</span> <span>{{ '@marketplace.orders.title'|trans }}</span>{% endblock %}

{% block marketplace_body %}
{% if orders|length == 0 %}
    <p class="marketplace-empty">{{ '@marketplace.orders.empty'|trans }}</p>
{% else %}
<table class="marketplace-lines">
    <thead><tr><th>{{ '@marketplace.orders.reference'|trans }}</th><th>{{ '@marketplace.orders.store'|trans }}</th><th>{{ '@marketplace.orders.date'|trans }}</th><th>{{ '@marketplace.orders.state'|trans }}</th><th class="num">{{ '@marketplace.cart.total'|trans }}</th></tr></thead>
    <tbody>
    {% for order in orders %}
        <tr>
            <td><a href="{{ path('marketplace_order', {reference: order.reference}) }}">{{ order.reference }}</a></td>
            <td>{{ order.store ? order.store.title : '—' }}</td>
            <td>{{ order.createdAt|date('d/m/Y H:i') }}</td>
            <td><span class="marketplace-state marketplace-state-{{ order.state|lower }}">{{ ('@marketplace.state.' ~ order.state|lower)|trans }}</span></td>
            <td class="num">{% include '@Marketplace/client/_price.html.twig' with {amount: order.netPrice, currency: order.currency} %}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>
{{ paginator(orders, 'marketplace_orders') }}
{% endif %}
{% endblock %}
