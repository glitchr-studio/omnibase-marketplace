{
    "name": "omnibase/marketplace",
    "type": "symfony-bundle",
    "description": "Marketplace for base-bundle: stores, products and variants, carts and orders, payment through pluggable gateways, sales rules (discounts, fees, taxes), reviews",
    "keywords": [
        "symfony",
        "marketplace",
        "ecommerce",
        "shop",
        "product",
        "order",
        "cart",
        "shopify"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibase-marketplace",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Marketplace\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Marketplace\\": "./tests"
        }
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/omnibase": "3.0.*-dev",
        "omnibase/admin": "dev-main",
        "glitchr/omnistate": "1.x-dev",
        "omnistate/annuaire-entreprises": "1.x-dev",
        "omnistate/vies": "1.x-dev",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0",
        "dompdf/dompdf": "^3.1",
        "horstoeko/zugferd": "^1.0.132",
        "symfony/lock": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "glitchr/omnibus": "2.x-dev",
        "glitchr/omnitrade": "1.x-dev",
        "phpunit/phpunit": "^9.6",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev",
        "allow-plugins": {
            "glitchr/base-plugin": true,
            "glitchr/doctrine-dc2type": true,
            "php-http/discovery": true
        }
    },
    "suggest": {
        "glitchr/omnitrade": "Pay through its gateways (omnitrade/stripe, omnitrade/paypal...): a PaymentMethod names one",
        "glitchr/omnibus": "Ship through its carriers (omnibus/mondial-relay, omnibus/ups...): a ShippingMethod names one"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/glitchr-studio/omnitrade"
        }
    ]
}
