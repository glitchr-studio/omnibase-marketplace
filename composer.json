{
    "name": "glitchr/base-bundle-market",
    "type": "symfony-bundle",
    "description": "Marketplace for base-bundle: stores, products and variants, carts and orders, payment through pluggable gateways, sales rules (discounts, fees, taxes), reviews",
    "keywords": [
        "symfony",
        "marketplace",
        "ecommerce",
        "shop",
        "product",
        "order",
        "cart",
        "shopify"
    ],
    "homepage": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/extension/marketplace",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/agnostic/backup-manager"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/component"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/extension/admin"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/base/plugin"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/doctrine-dc2type"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/well-known"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/symfony/bundle/ux/google-api"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/agnostic/omnistate/omnistate"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/agnostic/omnistate/vies"
        },
        {
            "type": "vcs",
            "url": "https://gitlab.glitchr.dev/public-repository/agnostic/omnistate/annuaire-entreprises"
        }
    ],
    "autoload": {
        "psr-4": {
            "Base\\Market\\": "./src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Base\\Market\\": "./tests"
        }
    },
    "require": {
        "php": "^8.2",
        "doctrine/orm": "^2.15|^3.0",
        "glitchr/base-bundle": "3.0.*-dev",
        "glitchr/base-bundle-admin": "dev-main",
        "glitchr/omnistate": "1.x-dev",
        "omnistate/annuaire-entreprises": "1.x-dev",
        "omnistate/vies": "1.x-dev",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/security-bundle": "^6.0|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "symfony/console": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/http-client": "^6.0|^7.0|^8.0",
        "symfony/messenger": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "minimum-stability": "dev",
        "allow-plugins": {
            "glitchr/base-plugin": true,
            "glitchr/doctrine-dc2type": true,
            "php-http/discovery": true
        }
    }
}
